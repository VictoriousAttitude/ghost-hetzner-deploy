1:03.410Z"},"backend/app/api/main.py":{"backupFileName":"d027411067bef932@v2","version":2,"backupTime":"2026-08-30T14:51:03.412Z"},"frontend/src/lib/roles.ts":{"backupFileName":"bf682a757a45152b@v2","version":2,"backupTime":"2026-08-30T14:51:03.413Z"},"frontend/src/routes/_layout/forbidden.tsx":{"backupFileName":"5541e293e289c23e@v2","version":2,"backupTime":"2026-08-30T14:51:03.415Z"},"frontend/src/routes/_layout/metrics.tsx":{"backupFileName":"c5d9a0138454426e@v2","version":2,"backupTime":"2026-08-30T14:51:03.416Z"},"frontend/src/routes/_layout/admin.tsx":{"backupFileName":"cd22b935a5adea20@v2","version":2,"backupTime":"2026-08-30T14:51:03.418Z"},"frontend/src/components/Sidebar/AppSidebar.tsx":{"backupFileName":"d8e70b9adc931a5c@v2","version":2,"backupTime":"2026-08-30T14:51:03.420Z"},"frontend/src/components/Admin/columns.tsx":{"backupFileName":"a5f90d86c57c62e8@v2","version":2,"backupTime":"2026-08-30T14:51:03.421Z"},"frontend/src/main.tsx":{"backupFileName":"537862e07c7b6c8e@v1","version":1,"backupTime":"2026-08-30T15:06:22.238Z"},"README.md":{"backupFileName":"315edfb4ab79194d@v1","version":1,"backupTime":"2026-08-30T15:11:37.408Z"},"docs/adr/001-role-model.md":{"backupFileName":null,"version":1,"backupTime":"2026-08-30T15:11:50.461Z"},"docs/adr/002-frontend-capability-propagation.md":{"backupFileName":null,"version":1,"backupTime":"2026-08-30T15:12:00.254Z"}},"timestamp":"2026-08-30T14:52:01.263Z"},"isSnapshotUpdate":true}
{"parentUuid":"8e7a7e60-aac8-490a-ab33-d082109ac8b9","isSidechain":false,"message":{"model":"claude-fable-5","id":"msg_011CeZ9WtU8faRzovXs3oFfK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013fCEWefPipdkCYzvs93RG5","name":"Write","input":{"file_path":"/home/dimakhaver/programming/EnderTuring/rbac-fastapi-task/docs/adr/002-frontend-capability-propagation.md","content":"# ADR 002: Frontend capability checks are UX only\n\nStatus: accepted\n\n## Context\n\nThe frontend needs to hide navigation and actions the user's role cannot perform, and\ndirect navigation to a forbidden route must show a friendly page. The backend already\nenforces everything; the question is how role awareness reaches the UI.\n\nOptions considered:\n\n1. **Mirror the permission mapping as capability helpers** (chosen)\n2. Backend-served capability list per user (e.g. `/users/me/capabilities`)\n3. Scatter `role === \"admin\"` literals through components\n\n## Decision\n\n`frontend/src/lib/roles.ts` mirrors `backend/app/api/permissions.py` as small\ncapability helpers (`canListUsers`, `canManageUsers`, `canViewMetrics`) over the\n`UserRole` type generated from the OpenAPI schema. The backend remains authoritative —\nthese checks are UX only.\n\n- Route guards use TanStack Router `beforeLoad` via a shared `requireCapability()`\n  helper: unauthenticated → `/login`, wrong role → `/forbidden`.\n- Nav links render only when the capability check passes; `/admin` is visible to\n  managers with write actions (add user, row actions) hidden.\n- Global error handling distinguishes 401 (drop token, redirect to login) from 403\n  (friendly forbidden page for queries, toast for mutations) — a 403 must never\n  destroy a valid session.\n\nA server-provided capability list was rejected as gold-plating for three roles: the\ngenerated `UserRole` type already keeps the mirror honest at compile time, and any\ndrift fails safe because the backend still returns 403.\n\n## Consequences\n\n- One file to update when the matrix changes; no role literals in components.\n- A user whose role changes mid-session may briefly see stale UI until the profile\n  refetches; the backend 403 path covers the gap.\n- No e2e tests for the guards (out of scope) — verification is lint/typecheck/build\n  plus the backend test matrix.\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1573,"cache_read_input_tokens":52387,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1573},"output_tokens":21,"service_tier":"standard","inference_geo":"not_available"}},"requestId":"req_011CeZ9Wqq8bYqSMNT7MWxf3","type":"assistant","uuid":"92a11a00-c516-4b87-9ab4-6c0eef2c2ab6","timestamp":"2026-08-30T15:12:00.242Z","userType":"external","cwd":"/home/dimakhaver/programming/EnderTuring/rbac-fastapi-task","sessionId":"4a1f3817-2385-4e23-95d7-028e997c9847","version":"2.1.74","gitBranch":"feature/rbac","slug":"jaunty-dancing-liskov"}
