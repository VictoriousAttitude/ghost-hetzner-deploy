92→+    app_name: str = Field(max_length=255)\n   393→+    maintenance_mode: bool\n   394→+\n   395→+\n   396→ # Generic message\n   397→ class Message(SQLModel):\n   398→     message: str\n   399→diff --git a/backend/tests/api/routes/test_rbac.py b/backend/tests/api/routes/test_rbac.py\n   400→new file mode 100644\n   401→index 0000000..684f957\n   402→--- /dev/null\n   403→+++ b/backend/tests/api/routes/test_rbac.py\n   404→@@ -0,0 +1,182 @@\n   405→+import pytest\n   406→+from fastapi.testclient import TestClient\n   407→+from sqlmodel import Session\n   408→+\n   409→+from app.core.config import settings\n   410→+from tests.utils.user import create_random_user\n   411→+from tests.utils.utils import random_email, random_lower_string\n   412→+\n   413→+ROLE_FIXTURES = {\n   414→+    \"admin\": \"superuser_token_headers\",\n   415→+    \"manager\": \"manager_token_headers\",\n   416→+    \"member\": \"normal_user_token_headers\",\n   417→+}\n   418→+\n   419→+\n   420→+def headers_for(request: pytest.FixtureRequest, role: str) -> dict[str, str]:\n   421→+    return request.getfixturevalue(ROLE_FIXTURES[role])  # type: ignore[no-any-return]\n   422→+\n   423→+\n   424→+@pytest.mark.parametrize(\n   425→+    (\"role\", \"expected_status\"),\n   426→+    [(\"admin\", 200), (\"manager\", 200), (\"member\", 403)],\n   427→+)\n   428→+def test_list_users_role_matrix(\n   429→+    client: TestClient, request: pytest.FixtureRequest, role: str, expected_status: int\n   430→+) -> None:\n   431→+    r = client.get(f\"{settings.API_V1_STR}/users/\", headers=headers_for(request, role))\n   432→+    assert r.status_code == expected_status\n   433→+\n   434→+\n   435→+@pytest.mark.parametrize(\n   436→+    (\"role\", \"expected_status\"),\n   437→+    [(\"admin\", 200), (\"manager\", 403), (\"member\", 403)],\n   438→+)\n   439→+def test_create_user_role_matrix(\n   440→+    client: TestClient, request: pytest.FixtureRequest, role: str, expected_status: int\n   441→+) -> None:\n   442→+    payload = {\"email\": random_email(), \"password\": random_lower_string()}\n   443→+    r = client.post(\n   444→+        f\"{settings.API_V1_STR}/users/\",\n   445→+        headers=headers_for(request, role),\n   446→+        json=payload,\n   447→+    )\n   448→+    assert r.status_code == expected_status\n   449→+\n   450→+\n   451→+@pytest.mark.parametrize(\n   452→+    (\"role\", \"expected_status\"),\n   453→+    [(\"admin\", 200), (\"manager\", 200), (\"member\", 403)],\n   454→+)\n   455→+def test_read_other_user_role_matrix(\n   456→+    client: TestClient,\n   457→+    db: Session,\n   458→+    request: pytest.FixtureRequest,\n   459→+    role: str,\n   460→+    expected_status: int,\n   461→+) -> None:\n   462→+    other_user = create_random_user(db)\n   463→+    r = client.get(\n   464→+        f\"{settings.API_V1_STR}/users/{other_user.id}\",\n   465→+        headers=headers_for(request, role),\n   466→+    )\n   467→+    assert r.status_code == expected_status\n   468→+\n   469→+\n   470→+@pytest.mark.parametrize(\"method\", [\"PATCH\", \"DELETE\"])\n   471→+@pytest.mark.parametrize(\n   472→+    (\"role\", \"expected_status\"),\n   473→+    [(\"admin\", 200), (\"manager\", 403), (\"member\", 403)],\n   474→+)\n   475→+def test_modify_any_user_role_matrix(\n   476→+    client: TestClient,\n   477→+    db: Session,\n   478→+    request: pytest.FixtureRequest,\n   479→+    method: str,\n   480→+    role: str,\n   481→+    expected_status: int,\n   482→+) -> None:\n   483→+    other_user = create_random_user(db)\n   484→+    r = client.request(\n   485→+        method,\n   486→+        f\"{settings.API_V1_STR}/users/{other_user.id}\",\n   487→+        headers=headers_for(request, role),\n   488→+        json={\"full_name\": \"Updated Name\"} if method == \"PATCH\" else None,\n   489→+    )\n   490→+    assert r.status_code == expected_status\n   491→+\n   492→+\n   493→+@pytest.mark.parametrize(\n   494→+    (\"role\", \"expected_status\"),\n  