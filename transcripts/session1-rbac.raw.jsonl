name=\"Full Stack FastAPI\", maintenance_mode=False)\n+\n+\n+@router.get(\"/\", response_model=GlobalSettings)\n+def read_global_settings() -> Any:\n+    \"\"\"\n+    Global application settings.\n+    \"\"\"\n+    return _global_settings\n+\n+\n+@router.put(\"/\", response_model=GlobalSettings)\n+def update_global_settings(settings_in: GlobalSettings) -> Any:\n+    \"\"\"\n+    Replace global application settings.\n+    \"\"\"\n+    global _global_settings\n+    _global_settings = settings_in\n+    return _global_settings\ndiff --git a/backend/app/api/routes/metrics.py b/backend/app/api/routes/metrics.py\nnew file mode 100644\nindex 0000000..088bf8f\n--- /dev/null\n+++ b/backend/app/api/routes/metrics.py\n@@ -0,0 +1,36 @@\n+from typing import Any\n+\n+from fastapi import APIRouter, Depends\n+from sqlmodel import func, select\n+\n+from app.api import permissions\n+from app.api.deps import SessionDep, require_roles\n+from app.models import MetricsSummary, User, UserRole\n+\n+router = APIRouter(prefix=\"/metrics\", tags=[\"metrics\"])\n+\n+\n+@router.get(\n+    \"/summary\",\n+    dependencies=[Depends(require_roles(*permissions.VIEW_METRICS))],\n+    response_model=MetricsSummary,\n+)\n+def read_metrics_summary(session: SessionDep) -> Any:\n+    \"\"\"\n+    User count metrics.\n+    \"\"\"\n+    total_users = session.exec(select(func.count()).select_from(User)).one()\n+    active_users = session.exec(\n+        select(func.count()).select_from(User).where(User.is_active)\n+    ).one()\n+    users_by_role = {\n+        role: session.exec(\n+            select(func.count()).select_from(User).where(User.role == role)\n+        ).one()\n+        for role in UserRole\n+    }\n+    return MetricsSummary(\n+        total_users=total_users,\n+        active_users=active_users,\n+        users_by_role=users_by_role,\n+    )\ndiff --git a/backend/app/api/routes/users.py b/backend/app/api/routes/users.py\nindex 1748f58..d0f82f2 100644\n--- a/backend/app/api/routes/users.py\n++