null\n+++ b/backend/tests/api/routes/test_rbac.py\n@@ -0,0 +1,179 @@\n+import pytest\n+from fastapi.testclient import TestClient\n+from sqlmodel import Session\n+\n+from app.core.config import settings\n+from tests.utils.user import create_random_user\n+from tests.utils.utils import random_email, random_lower_string\n+\n+ROLE_FIXTURES = {\n+    \"admin\": \"superuser_token_headers\",\n+    \"manager\": \"manager_token_headers\",\n+    \"member\": \"normal_user_token_headers\",\n+}\n+\n+\n+def headers_for(request: pytest.FixtureRequest, role: str) -> dict[str, str]:\n+    return request.getfixturevalue(ROLE_FIXTURES[role])  # type: ignore[no-any-return]\n+\n+\n+@pytest.mark.parametrize(\n+    (\"role\", \"expected_status\"),\n+    [(\"admin\", 200), (\"manager\", 200), (\"member\", 403)],\n+)\n+def test_list_users_role_matrix(\n+    client: TestClient, request: pytest.FixtureRequest, role: str, expected_status: int\n+) -> None:\n+    r = client.get(f\"{settings.API_V1_STR}/users/\", headers=headers_for(request, role))\n+    assert r.status_code == expected_status\n+\n+\n+@pytest.mark.parametrize(\n+    (\"role\", \"expected_status\"),\n+    [(\"admin\", 200), (\"manager\", 403), (\"member\", 403)],\n+)\n+def test_create_user_role_matrix(\n+    client: TestClient, request: pytest.FixtureRequest, role: str, expected_status: int\n+) -> None:\n+    payload = {\"email\": random_email(), \"password\": random_lower_string()}\n+    r = client.post(\n+        f\"{settings.API_V1_STR}/users/\",\n+        headers=headers_for(request, role),\n+        json=payload,\n+    )\n+    assert r.status_code == expected_status\n+\n+\n+@pytest.mark.parametrize(\n+    (\"role\", \"expected_status\"),\n+    [(\"admin\", 200), (\"manager\", 200), (\"member\", 403)],\n+)\n+def test_read_other_user_role_matrix(\n+    client: TestClient,\n+    db: Session,\n+    request: pytest.FixtureRequest,\n+    role: str,\n+    expected_status: int,\n+) -> None:\n+    other_user = create_random_user(db)\n+    r = client.get(\n+        f\"{settings.API_V1_STR}/users/{other_user.id}\",\n+        headers=headers_for(request, role),\n+    )\n+    assert r.status_code == expected_status\n+\n+\n+@pytest.mark.parametrize(\n+    (\"role\", \"expected_status\"),\n+    [(\"admin\", 200), (\"manager\", 403), (\"member\", 403)],\n+)\n+def test_update_any_user_role_matrix(\n+    client: TestClient,\n+    db: Session,\n+    request: pytest.FixtureRequest,\n+    role: str,\n+    expected_status: int,\n+) -> None:\n+    other_user = create_random_user(db)\n+    r = client.patch(\n+        f\"{settings.API_V1_STR}/users/{other_user.id}\",\n+        headers=headers_for(request, role),\n+        json={\"full_name\": \"Updated Name\"},\n+    )\n+    assert r.status_code == expected_status\n+\n+\n+@pytest.mark.parametrize(\n+    (\"role\", \"expected_status\"),\n+    [(\"admin\", 200), (\"manager\", 200), (\"member\", 403)],\n+)\n+def test_metrics_summary_role_matrix(\n+    client: TestClient, request: pytest.FixtureRequest, role: str, expected_status: int\n+) -> None:\n+    r = client.get(\n+        f\"{settings.API_V1_STR}/metrics/summary\", headers=headers_for(request, role)\n+    )\n+    assert r.status_code == expected_status\n+    if expected_status == 200:\n+        summary = r.json()\n+        assert summary[\"total_users\"] >= 1\n+        assert set(summary[\"users_by_role\"]) == {\"admin\", \"manager\", \"member\"}\n+\n+\n+@pytest.mark.parametrize(\n+    (\"method\", \"role\", \"expected_status\"),\n+    [\n+        (\"GET\", \"admin\", 200),\n+        (\"GET\", \"manager\", 403),\n+        (\"GET\", \"member\", 403),\n+        (\"PUT\", \"admin\", 200),\n+        (\"PUT\", \"manager\", 403),\n+        (\"PUT\", \"member\", 403),\n+    ],\n+)\n+def test_global_settings_role_matrix(\n+    client: TestClient,\n+    request: pytest.FixtureRequest,\n+    method: str,\n+    role: str,\n+    expected_status: int,\n+) -> None:\n+    body = {\"app_name\": \"Renamed App\", \"maintenance_mode\": True}\n+    r = client.request(\n+        method,\n+        f\"{settings.API_V1_STR}/settings/\",\n+        headers=headers_for(request, role),\n+        json=body if method == \"PUT\" else None,\n+    )\n+    assert r.status_code == expected_status\n+    if method == \"PUT\" and expected_status == 200:\n+        assert r.json() == body\n+\n+\n+def test_protected_endpoint_without_token_returns_401(client: TestClient) -> None:\n+    r = client.get(f\"{settings.API_V1_STR}/users/\")\n+    assert r.status_code == 401\n+\n+\n+def test_invalid_token_returns_401(client: TestClient) -> None:\n+    r = client.get(\n+        f\"{settings.API_V1_STR}/users/\",\n+        headers={\"Authorization\": \"Bearer not-a-valid-token\"},\n+    )\n+    assert r.status_code == 401\n+\n+\n+def test_member_can_read_and_update_own_profile(\n+    client: TestClient, normal_user_token_headers: dict[str, str]\n+) -> None:\n+    r = client.get(f\"{settings.API_V1_STR}/users/me\", headers=normal_user_token_headers)\n+    assert r.status_code == 200\n+    assert r.json()[\"role\"] == \"member\"\n+\n+    r = client.patch(\n+        f\"{settings.API_V1_STR}/users/me\",\n+        headers=normal_user_token_headers,\n+        json={\"full_name\": \"Own New Name\"},\n+    )\n+    assert r.status_code == 200\n+    assert r.json()[\"full_name\"] == \"Own New Name\"\n+\n+\n+def test_member_cannot_escalate_own_role(\n+    client: TestClient, normal_user_token_headers: dict[str, str]\n+) -> None:\n+    # UserUpdateMe has no role field; a submitted role must be ignored\n+    r = client.patch(\n+        f\"{settings.API_V1_STR}/users/me\",\n+        headers=normal_user_token_headers,\n+        json={\"full_name\": \"Sneaky\", \"role\": \"admin\"},\n+    )\n+    assert r.status_code == 200\n+    assert r.json()[\"role\"] == \"member\"\n+\n+\n+def test_signup_assigns_member_role(client: TestClient) -> None:\n+    payload = {\"email\": random_email(), \"password\": random_lower_string()}\n+    r = client.post(f\"{settings.API_V1_STR}/users/signup\", json=payload)\n+    assert r.status_code == 200\n+    assert r.json()[\"role\"] == \"member\"\ndiff --git a/backend/tests/conftest.py b/backend/tests/conftest.py\nindex 7cdabf3..36ef8b5 100644\n--- a/backend/tests/conftest.py\n+++ b/backend/tests/conftest.py\n@@ -7,7 +7,7 @@ from sqlmodel import Session, delete\n from app.core.config import settings\n from app.core.db import engine, init_db\n from app.main import app\n-from app.models import Item, User\n+from app.models import Item, User, UserRole\n from tests.utils.user import authentication_token_from_email\n from tests.utils.utils import get_superuser_token_headers\n \n@@ -40,3 +40,10 @@ def normal_user_token_headers(client: TestClient, db: Session) -> dict[str, str]\n     return authentication_token_from_email(\n         client=client, email=settings.EMAIL_TEST_USER, db=db\n     )\n+\n+\n+@pytest.fixture(scope=\"module\")\n+def manager_token_headers(client: TestClient, db: Session) -> dict[str, str]:\n+    return authentication_token_from_email(\n+        client=client, email=\"manager@example.com\", db=db, role=UserRole.manager\n+    )\ndiff --git a/backend/tests/utils/user.py b/backend/tests/utils/user.py\nindex 5867431..84af62f 100644\n--- a/backend/tests/utils/user.py\n+++ b/backend/tests/utils/user.py\n@@ -3,7 +3,7 @@ from sqlmodel import Session\n \n from app import crud\n from app.core.config import settings\n-from app.models import User, UserCreate, UserUpdate\n+from app.models import User, UserCreate, UserRole, UserUpdate\n from tests.utils.utils import random_email, random_lower_string\n \n \n@@ -28,20 +28,20 @@ def create_random_user(db: Session) -> User:\n \n \n def authentication_token_from_email(\n-    *, client: TestClient, email: str, db: Session\n+    *, client: TestClient, email: str, db: Session, role: UserRole = UserRole.member\n ) -> dict[str, str]:\n     \"\"\"\n-    Return a valid token for the user with given email.\n+    Return a valid token for the user with given email and role.\n \n     If the user doesn't exist it is created first.\n     \"\"\"\n     password = random_lower_string()\n     user = crud.get_user_by_email(session=db, email=email)\n     if not user:\n-        user_in_create = UserCreate(email=email, password=password)\n+        user_in_create = UserCreate(email=email, password=password, role=role)\n         user = crud.create_user(session=db, user_create=user_in_create)\n     else:\n-        user_in_update = UserUpdate(password=password)\n+        user_in_update = UserUpdate(password=password, role=role)\n         if not user.id:\n             raise Exception(\"User id not set\")\n         user = crud.update_user(session=db, db_user=user, user_in=user_in_update)\ndiff --git a/docs/plan.md b/docs/plan.md\nnew file mode 100644\nindex 0000000..190519f\n--- /dev/null\n+++ b/docs/plan.md\n@@ -0,0 +1,155 @@\n+# RBAC Implementation Plan\n+\n+> **For agentic workers:** executed inline in this session (superpowers:executing-plans), TDD per milestone, one conventional commit per milestone, `uv run prek run --all-files` green before every commit.\n+\n+**Goal:** Role-based access control (admin / manager / member) enforced in the backend via one dependency factory, mirrored as UX-only guards in the frontend.\n+\n+**Architecture:** Single `role` enum column on `User` (source of truth; `is_superuser` kept for template compatibility). One `require_roles(*roles)` dependency in `app/api/deps.py`; central action→roles mapping in `app/api/permissions.py`; routes never contain role literals. Frontend reads `role` from `UserPublic` and mirrors the mapping in `src/lib/roles.ts`.\n+\n+**Tech stack:** FastAPI, SQLModel, Alembic, PostgreSQL enum; React + TanStack Router; openapi-ts generated client.\n+\n+## Global constraints\n+\n+- 401 = missing/invalid credentials; 403 = authenticated but not permitted. Never mix.\n+- Every denial: `logger.warning` with user id + route.\n+- No inline role literals in route bodies; adding a role touches ≤3 files (enum, permissions map, migration).\n+- Tests: parametrized role×endpoint, allowed AND denied cases, plus 401 unauthenticated. Few and sharp.\n+- Frontend verified by lint/typecheck/build only (no e2e).\n+\n+## Permission matrix (single source: `app/api/permissions.py`)\n+\n+| Action | Constant | admin | manager | member |\n+|---|---|---|---|---|\n+| List users `GET /users/` | `LIST_USERS` | ✓ | ✓ | ✗ |\n+| Create user `POST /users/` | `MANAGE_USERS` | ✓ | ✗ | ✗ |\n+| Update/delete any user `PATCH/DELETE /users/{id}` | `MANAGE_USERS` | ✓ | ✗ | ✗ |\n+| Read other user `GET /users/{id}` | `READ_ANY_USER` | ✓ | ✓ | self only |\n+| Metrics `GET /metrics/summary` | `VIEW_METRICS` | ✓ | ✓ | ✗ |\n+| Global settings `GET/PUT /settings/` | `MANAGE_SETTINGS` | ✓ | ✗ | ✗ |\n+| Own profile `GET/PATCH /users/me` | (authenticated) | ✓ | ✓ | ✓ |\n+| `POST /users/signup` | public; always assigns `member` | — | — | — |\n+\n+---\n+\n+## Milestone 1 — `feat: add role column to user model with migration`\n+\n+**Files:** modify `backend/app/models.py`, `backend/app/core/db.py`; create `backend/app/alembic/versions/<rev>_add_role_to_user.py` (down_revision `fe56fa70289e`).","is_error":false}]},"uuid":"05ba46fb-a439-4e93-a5b2-04d38d8f65f5","timestamp":"2026-08-30T14:55:20.448Z"},"type":"agent_progress","prompt":"","agentId":"a81bed5c18197e77f"},"toolUseID":"agent_msg_011CeZ8F24y5Ee9kiprHmajk","parentToolUseID":"toolu_013crcSWRNmFYZEEHUGgS3Xh","uuid":"0d3b8b52-f1c1-43c9-8142-f6fcc86a38a5","timestamp":"2026-08-30T14:55:20.449Z","userType":"external","cwd":"/home/dimakhaver/programming/EnderTuring/rbac-fastapi-task/frontend","sessionId":"4a1f3817-2385-4e23-95d7-028e997c9847","version":"2.1.74","gitBranch":"feature/rbac","slug":"jaunty-dancing-liskov"}
